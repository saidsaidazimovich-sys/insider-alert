# Copy to .env for local runs. NEVER commit the real .env.
# On GitHub these become repository secrets instead.

# SEC requires a descriptive User-Agent with a real contact address.
# Requests without it get 403. Put your own name and email here.
SEC_USER_AGENT="Ism Familiya siz@example.com"

# From @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=

# Your chat id (see README for how to read it).
TELEGRAM_CHAT_ID=

# Optional, only if you switch market.provider to finviz.
FINVIZ_AUTH_TOKEN=
